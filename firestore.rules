rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── funções ─────────────────────────────────────────────────────────────
    function emailAtual() {
      return request.auth.token.email.lower();
    }

    // logado com e-mail verificado e cadastrado (e ativo) em usuarios/{email}
    function ativo() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/usuarios/$(emailAtual()))
        && get(/databases/$(database)/documents/usuarios/$(emailAtual())).data.ativo == true;
    }

    function gestor() {
      return ativo()
        && get(/databases/$(database)/documents/usuarios/$(emailAtual())).data.papel == "gestor";
    }

    // ── usuarios/{email} (ID = e-mail em minúsculas) ────────────────────────
    match /usuarios/{email} {
      allow read: if (request.auth != null && emailAtual() == email) || gestor();
      allow create, update, delete: if gestor();
    }

    // ── checklists/{unidade_mês} ────────────────────────────────────────────
    match /checklists/{doc} {
      allow read, create, update: if ativo();
      allow delete: if gestor();

      match /fotos/{foto} {
        allow read: if ativo();
        allow create: if ativo()
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.dados is string
          && request.resource.data.dados.size() < 400000;
        allow delete: if gestor() || resource.data.autorUid == request.auth.uid;
        allow update: if false;
      }
    }

    // ── todo o resto (inclusive _config): negado ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
